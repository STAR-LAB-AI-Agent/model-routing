# ===== 脱敏配置示例（复制为 .env 后填写，.env 已在 .gitignore 中，禁止提交真实 Key）=====
# 模式切换：1 = 离线 Mock（无 Key 也能完整运行/演示）；0 = 真实模型（需下方至少一个 Key）
USE_MOCK=1

# 模型 API Key（仅从环境变量读取，代码/日志中不出现）
# OPENAI_API_KEY=sk-xxx
# DASHSCOPE_API_KEY=sk-xxx
# QWEN_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx

# 长文本阈值（字符数，超过触发 long_context 路由）
LONG_CONTEXT_THRESHOLD=2000

# 审计日志路径
ROUTER_LOG_PATH=./logs/router.log
